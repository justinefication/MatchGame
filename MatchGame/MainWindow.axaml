<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="MatchGame.MainWindow"
        Title="Matcherate It!" Width="400" Height="450">
    <DockPanel>
        <TextBlock
            x:Name="TimerTextBlock"
            DockPanel.Dock="Bottom"
            Margin="0 5 0 10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="36"
            TextAlignment="Center"
            Text="0:00"
        />
        
        <Grid x:Name="MainGrid" ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*,*">
            <!--
                Improve Head First C# Match Game by consolidating common properties
                of TextBlock controls to avoid duplicates. We define the Styles inside
                of Grid instead of Window because the TextBlock controls that only
                needs this pack of property setters are the ones in the grid.
            -->
            <Grid.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="FontSize" Value="36" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Text" Value="?" />
                </Style>
            </Grid.Styles>

            <TextBlock Grid.Row="0" Grid.Column="0" />
            <TextBlock Grid.Row="0" Grid.Column="1" />
            <TextBlock Grid.Row="0" Grid.Column="2" />
            <TextBlock Grid.Row="0" Grid.Column="3" />
        
            <TextBlock Grid.Row="1" Grid.Column="0" />
            <TextBlock Grid.Row="1" Grid.Column="1" />
            <TextBlock Grid.Row="1" Grid.Column="2" />
            <TextBlock Grid.Row="1" Grid.Column="3" />
        
            <TextBlock Grid.Row="2" Grid.Column="0" />
            <TextBlock Grid.Row="2" Grid.Column="1" />
            <TextBlock Grid.Row="2" Grid.Column="2" />
            <TextBlock Grid.Row="2" Grid.Column="3" />
        
            <TextBlock Grid.Row="3" Grid.Column="0" />
            <TextBlock Grid.Row="3" Grid.Column="1" />
            <TextBlock Grid.Row="3" Grid.Column="2" />
            <TextBlock Grid.Row="3" Grid.Column="3" />
        </Grid>
    </DockPanel>
</Window>